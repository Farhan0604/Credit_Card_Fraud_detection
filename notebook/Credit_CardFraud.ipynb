   "source": [
    "DATA_PATH = \"creditcard.csv\n" 
    "df = pd.read_csv(DATA_PATH)\n",
    "print(\"Shape:\", df.shape)\n",
    "print(df['Class'].value_counts())\n",
    "df.head()\n"
   ]
